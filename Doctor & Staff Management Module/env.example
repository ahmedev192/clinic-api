# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite by default)
# DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL (uncomment and configure if needed)
# DATABASE_URL=postgresql://user:password@localhost:5432/clinic_management

# For MySQL (uncomment and configure if needed)
# DATABASE_URL=mysql://user:password@localhost:3306/clinic_management

# Email Configuration (optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Media and Static Files
# MEDIA_ROOT=/path/to/media
# STATIC_ROOT=/path/to/static

# Logging
# LOG_LEVEL=INFO
# LOG_FILE=/path/to/logs/django.log
