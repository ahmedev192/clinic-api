# DATA_UPLOAD_MAX_MEMORY_SIZE=10485760  # 10MB

# Logging Configuration
# LOG_LEVEL=INFO
# LOG_FILE=logs/django.log

# CORS Settings
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security Settings (Production)
