# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
DATABASE_URL=postgresql://auth_user:auth_password@localhost:5432/auth_backend

# Redis
REDIS_URL=redis://localhost:6379/0

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# Security Settings
PASSWORD_RESET_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900
MFA_REQUIRED=False
SSO_ENABLED=True

# OAuth2/SSO Configuration
# Google OAuth2
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth2/callback/

# Microsoft OAuth2
OAUTH_MICROSOFT_CLIENT_ID=your-microsoft-client-id
OAUTH_MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
OAUTH_MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/oauth2/callback/

# GitHub OAuth2
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret
OAUTH_GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/oauth2/callback/

# Okta OAuth2 (Optional)
OAUTH_OKTA_CLIENT_ID=your-okta-client-id
OAUTH_OKTA_CLIENT_SECRET=your-okta-client-secret
OAUTH_OKTA_REDIRECT_URI=http://localhost:8000/api/v1/oauth2/callback/
OAUTH_OKTA_DISCOVERY_URL=https://your-domain.okta.com/.well-known/openid_configuration

# Auth0 OAuth2 (Optional)
OAUTH_AUTH0_CLIENT_ID=your-auth0-client-id
OAUTH_AUTH0_CLIENT_SECRET=your-auth0-client-secret
OAUTH_AUTH0_REDIRECT_URI=http://localhost:8000/api/v1/oauth2/callback/
OAUTH_AUTH0_DOMAIN=your-domain.auth0.com

# Keycloak OAuth2 (Optional)
OAUTH_KEYCLOAK_CLIENT_ID=your-keycloak-client-id
OAUTH_KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
OAUTH_KEYCLOAK_REDIRECT_URI=http://localhost:8000/api/v1/oauth2/callback/
OAUTH_KEYCLOAK_DISCOVERY_URL=https://your-keycloak-domain/realms/your-realm/.well-known/openid_configuration

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Site Information
SITE_NAME=Authentication Backend
SITE_DOMAIN=yourdomain.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Rate Limiting
RATELIMIT_ENABLE=True
RATELIMIT_USE_CACHE=default

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Production Settings (uncomment for production)
# DEBUG=False
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_BROWSER_XSS_FILTER=True
# SECURE_CONTENT_TYPE_NOSNIFF=True

