            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/profile/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "profile", ""]
            }
          },
          "response": []
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"John Updated\",\n  \"last_name\": \"Doe Updated\",\n  \"phone_number\": \"+1234567891\",\n  \"timezone\": \"America/New_York\",\n  \"language\": \"en\",\n  \"profile\": {\n    \"bio\": \"Updated bio\",\n    \"company\": \"Updated Company\",\n    \"job_title\": \"Updated Job Title\",\n    \"location\": \"New York, NY\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/profile/update/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "profile", "update", ""]
            }
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"securepassword123\",\n  \"new_password\": \"newpassword123\",\n  \"new_password_confirm\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password/change/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "password", "change", ""]
            }
          },
          "response": []
