            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"reset-token-uuid\",\n  \"new_password\": \"newpassword123\",\n  \"new_password_confirm\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password-reset/confirm/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "password-reset", "confirm", ""]
            }
