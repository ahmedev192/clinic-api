            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider_id\": \"provider-uuid\",\n  \"redirect_uri\": \"http://localhost:3000/callback\",\n  \"state\": \"random-state-string\",\n  \"scopes\": [\"openid\", \"profile\", \"email\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/oauth2/authorize/",
